# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Environment files hold keys: never commit them. .env.example is the template.
.env
.env.*
!.env.example
supabase/.env

# Capacitor native projects are generated by `npx cap add android|ios`
android/
ios/

# Editors and OS
.DS_Store
.idea/
*.log

# Vercel CLI link (`vercel link`): which Vercel project this folder deploys to
.vercel

# Indoor map: local debug page (npm run map:debug) and the school layout PDF
map-debug/
map-inputs/

# Secrets and keys of any kind: never commit them
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
*.mobileprovision
service-account*.json
google-services.json
GoogleService-Info.plist
supabase/.temp/
supabase/.branches/
.npmrc
.secrets

# Python bytecode from the map tracing scripts
__pycache__/

# Wall audit pictures (tools/map-extract/review): they show the real school plan, like layout.pdf
tools/map-extract/review/

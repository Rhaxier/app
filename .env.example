# Copy this file to .env and fill it in. Never commit .env.

# --- Supabase connection ---------------------------------------------------
# Local: run `npm run db:start`, then copy the API URL and the anon key
# (the CLI may call it the "Publishable key") from its output.
# Cloud: Supabase dashboard > Project Settings > API.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=paste-your-anon-key-here

# --- Sign-in (docs/OPEN_QUESTIONS.md, Q5) ------------------------------------
# dev   = email + password for the seeded @dev.local users, plus the role switcher
# google | azure = school Google or Microsoft accounts, once school IT sets them up
VITE_AUTH_PROVIDER=dev

# The school's email domain, e.g. school.example. Only a hint for the Google /
# Microsoft account picker. The real gate is app_settings.school_email_domain
# in the database.
VITE_SCHOOL_EMAIL_DOMAIN=[school-domain]

# --- Phone push notifications (Q8) ------------------------------------------
# Leave false until push is configured in Firebase / Apple.
VITE_ENABLE_PUSH=false

# --- Indoor map with directions (MAP_NOTES.md) --------------------------------
# false = /map is the old map; staff can try the new one at /map/indoor.
# Turn on in the same release as rooms migration B (see the runbooks).
VITE_INDOOR_MAP=false
